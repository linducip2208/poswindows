{
  "app": {
    "name": "KasirPro",
    "version": "2.4.0",
    "offline": true
  },
  "database": {
    "journalMode": "WAL",
    "busyTimeoutMs": 10000
  },
  "backup": {
    "keep": 30,
    "onCloseShift": true,
    "onExitIfDirty": true
  },
  "logging": {
    "dir": "Logs",
    "level": "info"
  }
}
